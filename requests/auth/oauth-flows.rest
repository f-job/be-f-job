@baseUrl = http://localhost:4300/api

### 1. Login or Register via Google
# Expected: 200 OK with accessToken, refreshToken, and user info (role: CANDIDATE if new)
# Note: You need a real Google ID Token to test this properly.
POST {{baseUrl}}/auth/oauth/google
Content-Type: application/json

{
  "token": "YOUR_GOOGLE_ID_TOKEN_HERE"
}

### 2. Login or Register via Facebook
# Expected: 200 OK with accessToken, refreshToken, and user info
# Note: You need a real Facebook Access Token to test this properly.
POST {{baseUrl}}/auth/oauth/facebook
Content-Type: application/json

{
  "token": "YOUR_FACEBOOK_ACCESS_TOKEN_HERE"
}
