# Server
NODE_ENV=development
PORT=4300
SERVER_URL=http://localhost:4300

# Database
MYSQL_DATABASE_URL=mysql://root:@localhost:3306/express_boilerplate

# JWT
JWT_SECRET=my_super_secret_jwt_key_123456789012
REFRESH_TOKEN_SECRET=my_super_refresh_secret_123456789
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Frontend
FRONTEND_URL=http://localhost:3000

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASSWORD=testpassword
SMTP_FROM=test@gmail.com

# App
APP_NAME=F-Job