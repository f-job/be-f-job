# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4300
APP_NAME=F-Job
SERVER_URL=http://localhost:4300
FRONTEND_URL=http://localhost:3000

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://...

# ─── JWT ───────────────────────────────────────────────────────────────────────
# SECURITY: Use at least 32 random characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=long_secret_string_32_chars_1
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=long_secret_string_32_chars_2
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Optional in development. Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com